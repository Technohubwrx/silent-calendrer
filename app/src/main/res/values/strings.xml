    <!-- Onboarding -->
    <string name="onb_title">Set up Silent Calendrer</string>
    <string name="onb_intro">Silent Calendrer silences your phone 10 minutes before each meeting and turns the ringer back on 15 minutes after it ends. It needs a few permissions to do this.</string>
    <string name="onb_calendar_title">Calendar access</string>
    <string name="onb_calendar_body">Reads the meetings from calendars synced to this phone, including Google accounts. Nothing leaves your phone.</string>
    <string name="onb_dnd_title">Do Not Disturb access</string>
    <string name="onb_dnd_body">Android only lets apps with this access switch the phone to Silent and back. On the next screen, turn it on for Silent Calendrer.</string>
    <string name="onb_alarm_title">Alarms and reminders</string>
    <string name="onb_alarm_body">Lets the app switch at the exact minute. Without it, Android may delay switching by several minutes.</string>
    <string name="onb_notif_title">Notifications</string>
    <string name="onb_notif_body">Shows \"Silent until …\" during meetings and warns you if switching fails.</string>
    <string name="onb_battery_title">Battery (optional)</string>
    <string name="onb_battery_body">Some phone makers stop background apps. If switching is unreliable on your phone, allow Silent Calendrer to run without battery restrictions.</string>
    <string name="onb_grant">Grant</string>
    <string name="onb_open_settings">Open settings</string>
    <string name="onb_granted">Granted</string>
    <string name="onb_done">Continue</string>
    <string name="onb_skip_warning">Missing permissions limit what the app can do. You can grant them later from the warning on the main screen.</string>

